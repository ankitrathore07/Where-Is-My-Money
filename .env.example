# Where Is My Money local environment.
# Copy this file to .env and fill in real values. Never commit .env.

# Application environment: "development" or "production".
APP_ENV=development

# Session-signing key. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production a missing or default key must fail fast.
SECRET_KEY=dev-only-ephemeral-key-do-not-use-in-production

# SQLite path (PR 2). Later: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///data/where-is-my-money.db

# Google OAuth (PR 3). Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
