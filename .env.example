# Where Is My Money local environment.
# Copy this file to .env and fill in real values. Never commit .env.

# Application environment: "development", "test", or "production".
APP_ENV=development

# Session-signing key. Generate one with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Development replaces this documented placeholder with an ephemeral key and warns.
# Production requires a unique value of at least 32 characters and HTTPS.
SECRET_KEY=dev-only-ephemeral-key-do-not-use-in-production

# SQLite path (PR 2). Later: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///data/where-is-my-money.db

# Google OAuth web credentials. Configure this exact authorized redirect URI:
# http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JSON list of HTTP Host header values accepted by the application.
# Add the deployed hostname in production; wildcards are rejected.
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]

# Optional description-only transaction categorization. The feature is off by default.
# The classifier receives only a sanitized description and the built-in category allowlist.
OPENAI_API_KEY=
OPENAI_CATEGORIZATION_ENABLED=false
OPENAI_CATEGORIZATION_MODEL=gpt-5.4-nano
OPENAI_CATEGORIZATION_TIMEOUT_SECONDS=8
